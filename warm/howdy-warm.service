[Unit]
Description=Howdy face recognition kept loaded (fast face unlock)
Documentation=https://github.com/kenners22/omarchy-xps14-face-unlock
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/lib/howdy-warm/howdy-warmd
RuntimeDirectory=howdy-warm
RuntimeDirectoryMode=0755
Restart=on-failure
# A scan killed hard (SIGKILL, a wedged STREAMOFF) skips the service's own
# LED-off handler; this runs after the process is gone, however it ended.
ExecStopPost=-/bin/sh -c 'echo 0 > "/sys/class/leds/HIMX1092_00::ir_flood_led/brightness"'
RestartSec=2
SyslogIdentifier=howdy-warm
# Hardening that leaves the camera, its sysfs LED and /etc/howdy reachable
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectSystem=full
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
